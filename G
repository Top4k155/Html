<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Автономный P2P Менеджер Задач</title>
    <style>
        :root {
            --bg-color: #121212;
            --panel-bg: #1e1e1e;
            --text-color: #e0e0e0;
            --accent-color: #00adb5;
            --protest-bg: #3a0007;
            --protest-border: #ff3344;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        #protest-banner {
            width: 100%;
            background-color: var(--protest-bg);
            border-bottom: 2px solid var(--protest-border);
            padding: 12px 20px;
            box-sizing: border-box;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        .protest-text {
            font-size: 14px;
            color: #ffcccc;
            margin-right: 15px;
            line-height: 1.4;
        }
        .protest-text a {
            color: #ff6677;
            text-decoration: underline;
            font-weight: bold;
        }
        .close-banner-btn {
            background: none;
            border: none;
            color: #ffcccc;
            font-size: 20px;
            cursor: pointer;
            padding: 0 5px;
        }
        .container {
            width: 90%;
            max-width: 800px;
            margin: 20px auto;
            padding: 20px;
        }
        h1, h2 { color: var(--accent-color); }
        .panel {
            background-color: var(--panel-bg);
            border: 1px solid #333;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }
        .network-status {
            display: inline-block;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background-color: #ff3333;
            margin-right: 8px;
        }
        .network-status.connected { background-color: #33ff33; }
        textarea {
            width: 100%;
            height: 80px;
            background-color: #2d2d2d;
            border: 1px solid #444;
            color: #fff;
            padding: 10px;
            border-radius: 4px;
            box-sizing: border-box;
            resize: vertical;
            margin-bottom: 10px;
            font-family: monospace;
        }
        button {
            background-color: var(--accent-color);
            border: none;
            color: #121212;
            padding: 10px 15px;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
            margin-right: 5px;
            margin-bottom: 5px;
        }
        .task-input-group {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }
        .task-input-group input {
            flex: 1;
            padding: 10px;
            background-color: #2d2d2d;
            border: 1px solid #444;
            color: #fff;
            border-radius: 4px;
        }
        .task-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px;
            background-color: #252525;
            border-bottom: 1px solid #333;
            margin-bottom: 5px;
            border-radius: 4px;
        }
        .task-item.completed span {
            text-decoration: line-through;
            color: #777;
        }
    </style>
</head>
<body>
    <div id="protest-banner">
        <div class="protest-text">
            ✊ <strong>Внимание:</strong> Этот инструмент работает без участия серверов Big Tech. Мы заявляем протест против тотальной слежки, цензуры и сбора данных со стороны корпораций. Ваши данные принадлежат только вам. Узнайте больше на независимом ресурсе движения <a href="https://www.reddit.com/r/degoogle/" target="_blank" rel="noopener noreferrer">DeGoogle</a> или изучите <a href="https://en.wikipedia.org/wiki/Criticism_of_Google" target="_blank" rel="noopener noreferrer">Манифест критики корпораций</a>.
        </div>
        <button class="close-banner-btn" onclick="closeBanner()">&times;</button>
    </div>

    <div class="container">
        <h1>Автономный P2P Менеджер</h1>
        <div class="panel">
            <h2><span id="status-dot" class="network-status"></span> Синхронизация без серверов (P2P)</h2>
            <p style="font-size: 13px; color: #aaa;">Для обхода блокировок обменяйтесь одноразовыми ключами вручную с другим устройством.</p>
            <div>
                <button onclick="createOffer()">1. Создать код приглашения</button>
                <button onclick="createAnswer()">2. Создать ответ на чужой код</button>
                <button onclick="processAnswer()">3. Подтвердить подключение</button>
            </div>
            <p style="margin-top: 15px; margin-bottom: 5px;">Поле ввода / вывода текстового кода связи:</p>
            <textarea id="rtc-data-channel" placeholder="Вставьте код с другого устройства сюда..."></textarea>
        </div>

        <div class="panel">
            <h2>Мои Задачи (Хранятся локально)</h2>
            <div class="task-input-group">
                <input type="text" id="new-task-text" placeholder="Что нужно сделать?">
                <button onclick="addTask()">Добавить</button>
            </div>
            <div id="tasks-list"></div>
        </div>
    </div>

    <script>
        let tasks = JSON.parse(localStorage.getItem('p2p_tasks')) || [];
        let localConnection, dataChannel;
        const configuration = { iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] };

        if (localStorage.getItem('protest_banner_closed') === 'true') {
            document.getElementById('protest-banner').style.display = 'none';
        }
        function closeBanner() {
            document.getElementById('protest-banner').style.display = 'none';
            localStorage.setItem('protest_banner_closed', 'true');
        }

        function renderTasks() {
            const list = document.getElementById('tasks-list');
            list.innerHTML = '';
            tasks.sort((a, b) => b.updatedAt - a.updatedAt);
            tasks.forEach(task => {
                const item = document.createElement('div');
                item.className = `task-item ${task.completed ? 'completed' : ''}`;
                item.innerHTML = `
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <input type="checkbox" ${task.completed ? 'checked' : ''} onclick="toggleTask('${task.id}')">
                        <span>${escapeHtml(task.text)}</span>
                    </div>
                    <button style="background:#cc3333; color:white; padding: 5px 10px;" onclick="deleteTask('${task.id}')">Удалить</button>
                `;
                list.appendChild(item);
            });
            localStorage.setItem('p2p_tasks', JSON.stringify(tasks));
        }

        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        function addTask() {
            const input = document.getElementById('new-task-text');
            if (!input.value.trim()) return;
            tasks.push({ id: Math.random().toString(36).substr(2, 9), text: input.value, completed: false, updatedAt: Date.now() });
            input.value = '';
            renderTasks();
            broadcastData({ type: 'SYNC', payload: tasks });
        }

        function toggleTask(id) {
            tasks = tasks.map(t => t.id === id ? { ...t, completed: !t.completed, updatedAt: Date.now() } : t);
            renderTasks();
            broadcastData({ type: 'SYNC', payload: tasks });
        }

        function deleteTask(id) {
            tasks = tasks.filter(t => t.id !== id);
            renderTasks();
            broadcastData({ type: 'SYNC', payload: tasks });
        }

        function setupDataChannelHandlers() {
            dataChannel.onopen = () => {
                document.getElementById('status-dot').className = 'network-status connected';
                broadcastData({ type: 'SYNC', payload: tasks });
            };
            dataChannel.onclose = () => { document.getElementById('status-dot').className = 'network-status'; };
            dataChannel.onmessage = (e) => {
                const message = JSON.parse(e.data);
                if (message.type === 'SYNC') {
                    const localMap = new Map(tasks.map(t => [t.id, t]));
                    message.payload.forEach(rt => {
                        const lt = localMap.get(rt.id);
                        if (!lt || rt.updatedAt > lt.updatedAt) localMap.set(rt.id, rt);
                    });
                    tasks = Array.from(localMap.values());
                    renderTasks();
                }
            };
        }

        function broadcastData(data) {
            if (dataChannel && dataChannel.readyState === 'open') dataChannel.send(JSON.stringify(data));
        }

        async function createOffer() {
            localConnection = new RTCPeerConnection(configuration);
            dataChannel = localConnection.createDataChannel("taskSyncChannel");
            setupDataChannelHandlers();
            localConnection.onicecandidate = e => {
                if (!e.candidate) document.getElementById('rtc-data-channel').value = btoa(JSON.stringify(localConnection.localDescription));
            };
            const offer = await localConnection.createOffer();
            await localConnection.setLocalDescription(offer);
        }

        async function createAnswer() {
            const rawInput = document.getElementById('rtc-data-channel').value.trim();
            if (!rawInput) return alert("Вставьте код приглашения!");
            localConnection = new RTCPeerConnection(configuration);
            localConnection.ondatachannel = e => { dataChannel = e.channel; setupDataChannelHandlers(); };
            localConnection.onicecandidate = e => {
                if (!e.candidate) document.getElementById('rtc-data-channel').value = btoa(JSON.stringify(localConnection.localDescription));
            };
            await localConnection.setRemoteDescription(JSON.parse(atob(rawInput)));
            const answer = await localConnection.createAnswer();
            await localConnection.setLocalDescription(answer);
        }

        async function processAnswer() {
            const rawInput = document.getElementById('rtc-data-channel').value.trim();
            if (!rawInput) return alert("Вставьте ответный код!");
            await localConnection.setRemoteDescription(JSON.parse(atob(rawInput)));
        }

        renderTasks();
    </script>
</body>
</html>
